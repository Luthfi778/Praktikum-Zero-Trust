{
  "info": {
    "name": "Praktikum Zero Trust - Sistem Nilai",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "deviceId",
      "value": "DEV-MHS-01"
    }
  ],
  "item": [
    {
      "name": "Login Mahasiswa",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Device-ID",
            "value": "DEV-MHS-01"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"mhs1\", \"password\": \"mhs123\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d=pm.response.json();",
              "if(d.accessToken){pm.collectionVariables.set('accessToken',d.accessToken);pm.collectionVariables.set('refreshToken',d.refreshToken);pm.collectionVariables.set('deviceId','DEV-MHS-01');}"
            ]
          }
        }
      ]
    },
    {
      "name": "Lihat Nilai Mahasiswa",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "X-Device-ID",
            "value": "{{deviceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/nilai",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "nilai"
          ]
        }
      }
    },
    {
      "name": "Lihat Transkrip Sendiri",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "X-Device-ID",
            "value": "{{deviceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transkrip/2210001",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transkrip",
            "2210001"
          ]
        }
      }
    },
    {
      "name": "Uji Tolak Transkrip Mahasiswa Lain",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "X-Device-ID",
            "value": "{{deviceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transkrip/2210002",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transkrip",
            "2210002"
          ]
        }
      }
    },
    {
      "name": "Login Dosen 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Device-ID",
            "value": "DEV-DOSEN-01"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"dosen1\", \"password\": \"dosen123\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d=pm.response.json();",
              "if(d.accessToken){pm.collectionVariables.set('accessToken',d.accessToken);pm.collectionVariables.set('deviceId','DEV-DOSEN-01');pm.collectionVariables.set('refreshToken',d.refreshToken);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Dosen Lihat Nilai Kelas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "X-Device-ID",
            "value": "{{deviceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/nilai",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "nilai"
          ]
        }
      }
    },
    {
      "name": "Ubah Nilai ID 2 (kelas dosen1)",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "X-Device-ID",
            "value": "{{deviceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/nilai/2",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "nilai",
            "2"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"nilai\": 92}"
        }
      }
    },
    {
      "name": "Finalisasi Kelas ID 1",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "X-Device-ID",
            "value": "{{deviceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/kelas/1/finalisasi",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "kelas",
            "1",
            "finalisasi"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}"
        }
      }
    },
    {
      "name": "Login Admin",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Device-ID",
            "value": "DEV-ADMIN-01"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\": \"admin1\", \"password\": \"admin123\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d=pm.response.json();",
              "if(d.accessToken){pm.collectionVariables.set('accessToken',d.accessToken);pm.collectionVariables.set('deviceId','DEV-ADMIN-01');pm.collectionVariables.set('refreshToken',d.refreshToken);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin Lihat Transkrip",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "X-Device-ID",
            "value": "{{deviceId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/transkrip/2210002",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "transkrip",
            "2210002"
          ]
        }
      }
    },
    {
      "name": "Refresh Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "refresh"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\": \"{{refreshToken}}\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const d=pm.response.json();",
              "if(d.accessToken){pm.collectionVariables.set('accessToken',d.accessToken);pm.collectionVariables.set('refreshToken',d.refreshToken);}"
            ]
          }
        }
      ]
    },
    {
      "name": "Logout",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "logout"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"refreshToken\": \"{{refreshToken}}\"}"
        }
      }
    }
  ]
}